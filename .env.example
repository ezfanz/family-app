APP_NAME=E-Itinerary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Local: https://my-itenary.test (Herd). Production: your https domain, e.g. https://trip.example.com
APP_URL=https://my-itenary.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Supabase Postgres (Laravel is the only client). Use the pooler host from
# Supabase > Connect > Session pooler. Tests always use SQLite (phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=aws-1-<region>.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.<project-ref>
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production (https only): true
SESSION_SECURE_COOKIE=false
# Hosts that use the web session for /api, e.g. trip.example.com (defaults cover localhost and APP_URL)
# SANCTUM_STATEFUL_DOMAINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Yen to Ringgit: Bank Negara Malaysia, with ECB (Frankfurter) as backup. No keys needed.
BNM_API_URL=https://api.bnm.gov.my/public
FRANKFURTER_API_URL=https://api.frankfurter.dev/v1
EXCHANGE_RATE_CACHE_MINUTES=180

# Japan tax refund rules (refund method from 1 Nov 2026); still being verified.
TAX_REFUND_MIN_PRE_TAX_YEN=5000
TAX_REFUND_DAYS_TO_EXPORT=90

# Receipt photos. "receipts" = private folder on this server (fine locally).
# Production: s3 with a PRIVATE Supabase Storage bucket (Storage > S3 connection).
RECEIPTS_DISK=receipts

# Automatic receipt reading with Claude vision. Without a key, people type receipts in.
ANTHROPIC_API_KEY=
RECEIPT_READER=claude
RECEIPT_READER_QUICK_MODEL=claude-haiku-5-5
RECEIPT_READER_CAREFUL_MODEL=claude-sonnet-5-5
RECEIPT_READER_MIN_CONFIDENCE=0.75

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-2
AWS_BUCKET=receipts
AWS_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"
